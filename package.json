{
  "name": "propertyflow",
  "version": "0.1.0",
  "private": true,
  "description": "PropertyFlow - SaaS Property Management Platform (monorepo)",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --concurrency=15",
    "dev:apps": "turbo run dev --filter=@propertyflow/web --filter=@propertyflow/api",
    "dev:mobile": "pnpm --filter @propertyflow/mobile start",
    "start:mobile": "pnpm --filter @propertyflow/mobile start",
    "typecheck:mobile": "turbo run typecheck --filter=@propertyflow/mobile",
    "build:mobile:web": "pnpm --filter @propertyflow/mobile export:web",
    "build": "turbo run build",
    "lint": "eslint .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@next/eslint-plugin-next": "^15.1.4",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "@types/react": "19.1.17",
      "@types/react-dom": "19.0.4"
    }
  }
}
