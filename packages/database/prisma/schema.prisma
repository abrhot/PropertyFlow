// PropertyFlow database schema (Prisma + PostgreSQL).
// Phase 1: authentication & multi-tenancy (Organizations, Users, RBAC, refresh
// tokens, password resets). Phase 2: the property portfolio (Property, Unit).
// Lease/Payment models arrive in later phases (see docs/requirements.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  PROPERTY_MANAGER
  LEASING_AGENT
  ACCOUNTANT
  MAINTENANCE
  OWNER
  TENANT
}

enum SubscriptionTier {
  TRIAL
  STARTER
  GROWTH
  ENTERPRISE
}

enum PropertyType {
  SINGLE_FAMILY
  MULTI_FAMILY
  APARTMENT
  CONDO
  TOWNHOUSE
  COMMERCIAL
}

enum UnitStatus {
  VACANT
  OCCUPIED
  MAINTENANCE
  UNAVAILABLE
}

/// A management company: the "tenant" of the multi-tenant SaaS platform.
model Organization {
  id               String           @id @default(uuid())
  name             String
  slug             String           @unique
  subscriptionTier SubscriptionTier @default(TRIAL)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  users       User[]
  invitations OrganizationInvitation[]
  properties  Property[]
}

model User {
  id              String        @id @default(uuid())
  /// Null for SUPER_ADMIN (platform-wide, not tied to an organization).
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  String?
  email           String        @unique
  passwordHash    String
  fullName        String
  role            UserRole      @default(TENANT)
  isActive        Boolean       @default(true)
  emailVerifiedAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  invitationsSent     OrganizationInvitation[] @relation("InvitationsSent")
  propertiesOwned     Property[]               @relation("PropertiesOwned")

  @@index([organizationId])
}

/// Server-side record of an issued refresh token (rotation + revocation).
/// Only the hash is stored, never the raw token.
model RefreshToken {
  id        String    @id @default(uuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Single-use invitation to join an organization with a server-assigned role.
/// Only a SHA-256 hash of the bearer token is persisted.
model OrganizationInvitation {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  email          String
  role           UserRole
  tokenHash      String       @unique
  invitedBy      User         @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: Cascade)
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([organizationId, email])
}

/// A building or address in an organization's portfolio.
/// `ownerId` is what scopes the OWNER role to its own properties.
model Property {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  /// The property owner. Kept nullable so a property survives owner removal.
  owner          User?        @relation("PropertiesOwned", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId        String?
  name           String
  type           PropertyType @default(APARTMENT)
  addressLine1   String
  addressLine2   String?
  city           String
  state          String
  postalCode     String
  country        String       @default("US")
  yearBuilt      Int?
  notes          String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  units Unit[]

  @@index([organizationId])
  @@index([organizationId, ownerId])
}

/// A rentable space within a property. Scoped to an organization through
/// its property, so every query joins on `property.organizationId`.
model Unit {
  id              String     @id @default(uuid())
  property        Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId      String
  label           String
  bedrooms        Int        @default(0)
  bathrooms       Float      @default(1)
  squareFeet      Int?
  /// Minor currency units (cents) so rent arithmetic stays exact.
  marketRentCents Int        @default(0)
  status          UnitStatus @default(VACANT)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([propertyId, label])
  @@index([propertyId])
}
