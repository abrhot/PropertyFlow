// PropertyFlow database schema (Prisma + PostgreSQL).
// Phase 1: authentication & multi-tenancy (Organizations, Users, RBAC, refresh
// tokens, password resets). Phase 2: the property portfolio (Property, Unit).
// Lease/Payment models arrive in later phases (see docs/requirements.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ORG_ADMIN
  PROPERTY_MANAGER
  MAINTENANCE
  OWNER
  TENANT
}

enum SubscriptionTier {
  TRIAL
  STARTER
  GROWTH
  ENTERPRISE
}

enum PropertyType {
  SINGLE_FAMILY
  MULTI_FAMILY
  APARTMENT
  CONDO
  TOWNHOUSE
  COMMERCIAL
}

enum UnitStatus {
  VACANT
  OCCUPIED
  MAINTENANCE
  UNAVAILABLE
}

enum LeaseStatus {
  DRAFT
  PENDING_SIGNATURE
  ACTIVE
  EXPIRED
  TERMINATED
}

enum PaymentStatus {
  PENDING
  PAID
  LATE
  FAILED
  REFUNDED
}

enum MaintenancePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MaintenanceRequestStatus {
  SUBMITTED
  APPROVED
  REJECTED
  ASSIGNED
  IN_PROGRESS
  AWAITING_VERIFICATION
  VERIFIED
  COMPLETED
  CANCELLED
}

enum NotificationType {
  MAINTENANCE_SUBMITTED
  MAINTENANCE_APPROVED
  MAINTENANCE_REJECTED
  MAINTENANCE_ASSIGNED
  MAINTENANCE_COMPLETED
  MAINTENANCE_VERIFIED
  PAYMENT_DUE
  PAYMENT_RECEIVED
  GENERAL
}

enum WorkOrderStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  NEW
  SCREENING
  APPROVED
  DENIED
  WITHDRAWN
}

/// A single authorization rule (CASL "RawRule") for a role, stored as data so
/// the API and every client evaluate the exact same policy. The declarative
/// source of truth lives in `@propertyflow/auth`; the API reconciles this table
/// to it on boot. `conditions` may hold interpolation tokens (e.g. "{{userId}}")
/// that the API resolves for the current user before the rule is applied.
model AbilityRule {
  id         String   @id @default(uuid())
  role       UserRole
  /// A CASL action or list of actions, e.g. "read" or ["create", "update"].
  action     Json
  /// The subject/entity the rule applies to, e.g. "Property".
  subject    Json?
  /// Restricts the rule to specific fields of the subject.
  fields     String[] @default([])
  /// Attribute conditions (MongoDB-style) that scope the rule.
  conditions Json?
  /// When true the rule forbids instead of allows. Order matters: forbids must
  /// come after the grants they override, preserved via `sortOrder`.
  inverted   Boolean  @default(false)
  /// Human-readable explanation surfaced when an inverted rule blocks access.
  reason     String?
  /// Preserves the authored order within a role (CASL is order-sensitive).
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([role])
}

/// A management company: the "tenant" of the multi-tenant SaaS platform.
model Organization {
  id               String           @id @default(uuid())
  name             String
  slug             String           @unique
  subscriptionTier SubscriptionTier @default(TRIAL)
  isActive         Boolean          @default(true)
  // Editable organization profile (Settings → Organization). All optional so
  // existing orgs remain valid before an admin fills them in.
  contactEmail     String?
  contactPhone     String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  postalCode       String?
  websiteUrl       String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  users               User[]
  invitations         OrganizationInvitation[]
  properties          Property[]
  leases              Lease[]
  payments            Payment[]
  maintenanceRequests MaintenanceRequest[]
  workOrders          WorkOrder[]
  applications        Application[]
  conversations       Conversation[]
  messages            Message[]
  notifications       Notification[]
}

model User {
  id              String        @id @default(uuid())
  /// Nullable so an account can exist briefly before being attached to an org.
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  String?
  email           String        @unique
  passwordHash    String
  fullName        String
  role            UserRole      @default(TENANT)
  isActive        Boolean       @default(true)
  emailVerifiedAt DateTime?
  // Per-user notification preferences (Settings → Notifications).
  notifyByEmail       Boolean   @default(true)
  notifyPayments      Boolean   @default(true)
  notifyMaintenance   Boolean   @default(true)
  notifyMessages      Boolean   @default(true)
  notifyAnnouncements Boolean   @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  refreshTokens                RefreshToken[]
  passwordResetTokens          PasswordResetToken[]
  invitationsSent              OrganizationInvitation[] @relation("InvitationsSent")
  propertiesOwned              Property[]               @relation("PropertiesOwned")
  /// Buildings a PROPERTY_MANAGER is assigned to run. Empty for other roles.
  managedProperties            Property[]               @relation("PropertyManagers")
  leasesHeld                   Lease[]                  @relation("LeasesHeld")
  paymentsMade                 Payment[]                @relation("PaymentsMade")
  paymentsOwned                Payment[]                @relation("PaymentsOwned")
  maintenanceRequestsSubmitted MaintenanceRequest[]     @relation("MaintenanceRequestsSubmitted")
  maintenanceRequestsAssigned  MaintenanceRequest[]     @relation("MaintenanceRequestsAssigned")
  maintenanceRequestsOwned     MaintenanceRequest[]     @relation("MaintenanceRequestsOwned")
  workOrdersAssigned           WorkOrder[]              @relation("WorkOrdersAssigned")
  messagesSent                 Message[]                @relation("MessagesSent")
  notifications                Notification[]

  @@index([organizationId])
}

/// An in-app notification for a single recipient. Created by the API whenever a
/// meaningful event happens (a maintenance request is submitted, approved,
/// assigned, completed, or verified; a payment is due or received). The web app
/// polls the unread count to drive the header bell.
model Notification {
  id             String           @id @default(uuid())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  type           NotificationType
  title          String
  body           String
  /// Optional in-app path the notification links to, e.g. "/dashboard/maintenance".
  linkPath       String?
  isRead         Boolean          @default(false)
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

/// Server-side record of an issued refresh token (rotation + revocation).
/// Only the hash is stored, never the raw token.
model RefreshToken {
  id        String    @id @default(uuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Single-use invitation to join an organization with a server-assigned role.
/// Only a SHA-256 hash of the bearer token is persisted.
model OrganizationInvitation {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  email          String
  role           UserRole
  tokenHash      String       @unique
  invitedBy      User         @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: Cascade)
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([organizationId, email])
}

/// A building or address in an organization's portfolio.
/// `ownerId` is what scopes the OWNER role to its own properties.
model Property {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  /// The property owner. Kept nullable so a property survives owner removal.
  owner          User?        @relation("PropertiesOwned", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId        String?
  name           String
  type           PropertyType @default(APARTMENT)
  addressLine1   String
  addressLine2   String?
  city           String
  state          String
  postalCode     String
  country        String       @default("US")
  yearBuilt      Int?
  notes          String?
  /// Optional cover photo (URL). Real uploads arrive with the media service.
  imageUrl       String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  units    Unit[]
  /// Property managers assigned to run this building (many-to-many).
  managers User[] @relation("PropertyManagers")

  @@index([organizationId])
  @@index([organizationId, ownerId])
}

/// A rentable space within a property. Scoped to an organization through
/// its property, so every query joins on `property.organizationId`.
model Unit {
  id              String     @id @default(uuid())
  property        Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId      String
  label           String
  bedrooms        Int        @default(0)
  bathrooms       Float      @default(1)
  squareFeet      Int?
  /// Minor currency units (cents) so rent arithmetic stays exact.
  marketRentCents Int        @default(0)
  status          UnitStatus @default(VACANT)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  leases              Lease[]
  maintenanceRequests MaintenanceRequest[]
  applications        Application[]

  @@unique([propertyId, label])
  @@index([propertyId])
}

/// A rental agreement between a tenant and the organization for one unit.
/// `organizationId` is denormalized from the unit's property so tenant/owner
/// scoping and list queries stay a single-table lookup.
model Lease {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  unit           Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId         String
  /// The tenant on the lease. Always a TENANT-role user in the same organization.
  tenant         User         @relation("LeasesHeld", fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId       String
  status         LeaseStatus  @default(DRAFT)
  startDate      DateTime
  endDate        DateTime
  /// Monthly rent in minor currency units (cents).
  rentCents      Int
  depositCents   Int          @default(0)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  payments            Payment[]
  maintenanceRequests MaintenanceRequest[]

  @@index([organizationId])
  @@index([unitId])
  @@index([tenantId])
}

/// A rent charge or received payment tied to a lease. Tenant and owner ids are
/// denormalized so CASL scopes can be translated to efficient single-table queries.
model Payment {
  id             String        @id @default(uuid())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  lease          Lease         @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  leaseId        String
  tenant         User          @relation("PaymentsMade", fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId       String
  owner          User?         @relation("PaymentsOwned", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId        String?
  status         PaymentStatus @default(PENDING)
  amountCents    Int
  dueDate        DateTime
  paidAt         DateTime?
  description    String
  method         String?
  reference      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@index([leaseId])
  @@index([tenantId])
  @@index([organizationId, ownerId])
  @@index([organizationId, status, dueDate])
}

model MaintenanceRequest {
  id             String                   @id @default(uuid())
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  unit           Unit                     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId         String
  lease          Lease?                   @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  leaseId        String?
  tenant         User                     @relation("MaintenanceRequestsSubmitted", fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId       String
  owner          User?                    @relation("MaintenanceRequestsOwned", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId        String?
  assignee       User?                    @relation("MaintenanceRequestsAssigned", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId     String?
  title          String
  description    String
  priority       MaintenancePriority      @default(NORMAL)
  status         MaintenanceRequestStatus @default(SUBMITTED)
  submittedAt    DateTime                 @default(now())
  completedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  workOrder      WorkOrder?

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, tenantId])
  @@index([organizationId, assigneeId])
  @@index([unitId])
}

model WorkOrder {
  id                   String             @id @default(uuid())
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId       String
  maintenanceRequest   MaintenanceRequest @relation(fields: [maintenanceRequestId], references: [id], onDelete: Cascade)
  maintenanceRequestId String             @unique
  assignee             User               @relation("WorkOrdersAssigned", fields: [assigneeId], references: [id], onDelete: Restrict)
  assigneeId           String
  tenantId             String
  ownerId              String?
  status               WorkOrderStatus    @default(ASSIGNED)
  dueDate              DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  notes                String?
  /// Notes the technician records when marking the work complete.
  completionNotes      String?
  /// Photos the technician attaches as proof of completion (image URLs).
  imageUrls            String[]           @default([])
  referenceCode        String             @unique
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([organizationId])
  @@index([organizationId, assigneeId])
  @@index([organizationId, status])
}

/// A message thread between a tenant and their management company's staff.
/// `participantIds` is a denormalized list of the tenant user ids on the thread,
/// so a tenant's CASL scope (`participantIds` contains "{{userId}}") maps to a
/// single-table query. Staff are scoped org-wide and see every conversation.
model Conversation {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  subject        String
  participantIds String[]     @default([])
  lastMessageAt  DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  messages Message[]

  @@index([organizationId])
  @@index([organizationId, lastMessageAt])
}

/// A single message within a {@link Conversation}. `organizationId` is
/// denormalized for scoped queries; `senderId` is the authoring user.
model Message {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         User         @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  senderId       String
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([organizationId])
}

model Application {
  id                 String            @id @default(uuid())
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId     String
  unit               Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId             String
  applicantName      String
  applicantEmail     String
  applicantPhone     String?
  monthlyIncomeCents Int?
  desiredMoveIn      DateTime?
  status             ApplicationStatus @default(NEW)
  notes              String?
  submittedAt        DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([unitId])
  @@index([applicantEmail])
}
