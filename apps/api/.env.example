# Server
PORT=3001
NODE_ENV=development

# Web origin allowed by CORS (the Next.js app)
WEB_ORIGIN=http://localhost:3000

# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/propertyflow?schema=public"

# JWT secrets - generate strong random values in real environments
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Refresh cookie.
# COOKIE_SECURE=true in production; it also switches SameSite to None so the
# cookie survives a web app and an API on different domains (Vercel + Railway).
# Leave COOKIE_DOMAIN blank there to scope the cookie to the API host — shared
# platform domains like .vercel.app and .railway.app cannot be set as a domain.
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# Redis (background jobs - later phases)
REDIS_URL="redis://localhost:6379"

# Optional Gemini assistant provider. Without a key, PropertyFlow uses a safe demo fallback.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
