# Server
PORT=3001
NODE_ENV=development

# Web origin allowed by CORS (the Next.js app)
WEB_ORIGIN=http://localhost:3000

# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/propertyflow?schema=public"

# JWT secrets - generate strong random values in real environments
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Refresh cookie
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# Redis (background jobs - later phases)
REDIS_URL="redis://localhost:6379"
