{
  "expo": {
    "name": "PropertyFlow",
    "slug": "propertyflow-mobile",
    "scheme": "propertyflow",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F7F3EA"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.propertyflow.mobile"
    },
    "android": {
      "package": "com.propertyflow.mobile",
      "softwareKeyboardLayoutMode": "pan",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F7F3EA"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-system-ui",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://192.168.1.2:3001"
    }
  }
}
